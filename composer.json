{
    "name": "jojeringnax/airwallex-php-sdk",
    "description": "Framework-independent Airwallex Billing and Payments SDK for PHP.",
    "type": "library",
    "license": "MIT",
    "homepage": "https://github.com/jojeringnax/airwallex-php-sdk",
    "keywords": ["airwallex", "billing", "payments", "sdk"],
    "support": {
        "issues": "https://github.com/jojeringnax/airwallex-php-sdk/issues",
        "source": "https://github.com/jojeringnax/airwallex-php-sdk"
    },
    "require": {
        "php": ">=8.3 <8.6",
        "psr/http-client": "^1.0",
        "psr/http-factory": "^1.0",
        "psr/http-message": "^2.0",
        "psr/simple-cache": "^3.0"
    },
    "require-dev": {
        "guzzlehttp/guzzle": "^7.10",
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^12.5",
        "squizlabs/php_codesniffer": "^4.0"
    },
    "autoload": {
        "psr-4": {
            "Jojeringnax\\Airwallex\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Jojeringnax\\Airwallex\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "style": "phpcs",
        "style:fix": "phpcbf",
        "analyse": "phpstan analyse --no-progress --memory-limit=512M",
        "check": ["@test", "@style", "@analyse"],
        "check:consumer": "@php tools/check-consumer.php",
        "test:sandbox": "@php tools/sandbox.php"
    },
    "config": {
        "allow-plugins": {},
        "sort-packages": true
    }
}
