<?xml version="1.0"?>
<ruleset name="Airwallex PHP SDK">
    <description>PSR-12 for SDK, tests and development tools.</description>
    <file>src</file>
    <file>tests</file>
    <file>tools</file>
    <file>examples</file>
    <arg name="extensions" value="php"/>
    <arg name="colors"/>
    <rule ref="PSR12"/>
</ruleset>
